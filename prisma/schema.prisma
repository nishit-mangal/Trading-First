generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id              Int      @id @default(autoincrement())
  order_id        String   @unique
  trading_symbol  String
  quantity        Int
  average_price   Decimal  @db.Decimal(10, 2)
  status          String
  order_type      String
  validity        String
  order_timestamp DateTime
}

model otp {
  id         BigInt   @id @default(autoincrement())
  otp        Int
  user_id    BigInt?
  created_at DateTime @default(now())
  expired_at DateTime
  otp_type   String   @db.VarChar(255)
  user       users?   @relation(fields: [user_id], references: [id])
}

model users {
  id              BigInt         @id @default(autoincrement())
  email           String?        @unique @db.VarChar(255)
  password        String?        @db.VarChar(255)
  username        String?        @db.VarChar(255)
  phone_number    String?        @db.VarChar(255)
  is_verified     Boolean        @default(false)
  pin             String?        @db.Char(4)
  user_api_key    String?        @db.Uuid
  user_api_secret String?        @db.VarChar(255)
  picture         String?        @db.VarChar(255)
  holdings        holdings[]
  otps            otp[]
  upstox_users    upstox_users[]
}

model upstox_users {
  upstox_id String
  email     String
  user_name String?
  is_active Boolean?
  user_id   BigInt
  id        BigInt   @id @default(autoincrement())
  user      users    @relation(fields: [user_id], references: [id])
}

model holdings {
  id               BigInt   @id @default(autoincrement())
  user_id          BigInt
  company_name     String?
  quantity         Int?
  pnl              Decimal? @db.Decimal(10, 2)
  trading_symbol   String?
  last_price       Decimal? @db.Decimal(10, 2)
  instrument_token String?
  average_price    Decimal? @db.Decimal(10, 2)
  user             users    @relation(fields: [user_id], references: [id])
}
